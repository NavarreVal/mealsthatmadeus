---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const recipes = (await getCollection('recipes')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
	title="Recipes"
	description="Family dishes and the stories that come with them."
>
	<h1 class="page-title">Recipes</h1>
	<p class="page-lede">Family dishes and the stories that come with them.</p>

	<ul class="recipe-list recipe-list--full">
		{
			recipes.map((recipe) => (
				<li class="recipe-list__item">
					<a href={`/recipes/${recipe.id}/`} class="recipe-list__title">
						{recipe.data.title}
					</a>
					<p class="recipe-list__desc">{recipe.data.description}</p>
					{recipe.data.category && (
						<p class="recipe-list__meta">
							{recipe.data.category}
							{recipe.data.yield && ` · ${recipe.data.yield}`}
						</p>
					)}
				</li>
			))
		}
	</ul>
</BaseLayout>
