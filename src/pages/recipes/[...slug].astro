---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildRecipeJsonLd, recipeMarkdown, resolveLocalImageUrl } from '../../lib/recipe-schema';

export async function getStaticPaths() {
	const recipes = await getCollection('recipes');
	return recipes.map((recipe) => ({
		params: { slug: recipe.id },
		props: recipe,
	}));
}

type Props = CollectionEntry<'recipes'>;
const recipe = Astro.props;
const { Content } = await render(recipe);
const recipeJsonLd = buildRecipeJsonLd({
	title: recipe.data.title,
	description: recipe.data.description,
	author: recipe.data.author,
	pubDate: recipe.data.pubDate,
	updatedDate: recipe.data.updatedDate,
	yield: recipe.data.yield,
	prepTime: recipe.data.prepTime,
	cookTime: recipe.data.cookTime,
	totalTime: recipe.data.totalTime,
	category: recipe.data.category,
	tags: recipe.data.tags,
	imageUrl: resolveLocalImageUrl(recipe.data.heroImage, Astro.site),
	markdown: recipeMarkdown(recipe),
});
---

<BaseLayout title={recipe.data.title} description={recipe.data.description} jsonLd={[recipeJsonLd]}>
	<article>
		<p class="recipe-kicker">
			<FormattedDate date={recipe.data.pubDate} />
			{recipe.data.category && ` · ${recipe.data.category}`}
		</p>

		<h1 class="recipe-title">{recipe.data.title}</h1>

		<p class="recipe-dek">{recipe.data.description}</p>

		{
			(recipe.data.yield || recipe.data.prepTime || recipe.data.cookTime) && (
				<p class="recipe-times">
					{recipe.data.yield && <span>Yield: {recipe.data.yield}</span>}
					{recipe.data.prepTime && <span> · Prep: {recipe.data.prepTime}</span>}
					{recipe.data.cookTime && <span> · Cook: {recipe.data.cookTime}</span>}
				</p>
			)
		}

		<div class="recipe-content">
			<Content />
		</div>

		<p class="recipe-back">
			<a href="/recipes">← All Recipes</a>
		</p>
	</article>
</BaseLayout>
