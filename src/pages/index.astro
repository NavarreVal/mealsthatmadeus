---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/MTMU_hero.jpg';

const recipes = (await getCollection('recipes'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout>
	<section class="full-bleed home-hero">
		<Image
			src={heroImage}
			alt="Family meal — roasted chicken with citrus and herbs"
			class="home-hero__image"
			widths={[640, 960, 1440, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="home-hero__overlay">
			<div class="home-hero__copy">
				<p class="home-hero__quote">
					“Food, in the end, in our own tradition, is something holy… It’s about identity.”
				</p>
				<p class="home-hero__attribution">— Louise Fresco</p>
			</div>
		</div>
	</section>

	<p class="home-intro">
		A collection of family recipes and the stories that come with them — the dishes that shaped us, comforted us, and still bring us together.
	</p>

	<h2 class="section-title">Latest Recipes</h2>

	<ul class="recipe-list">
		{
			recipes.map((recipe) => (
				<li class="recipe-list__item">
					<a href={`/recipes/${recipe.id}/`} class="recipe-list__title">
						{recipe.data.title}
					</a>
					<p class="recipe-list__desc">{recipe.data.description}</p>
				</li>
			))
		}
	</ul>

	<p class="more-link">
		<a href="/recipes">View all recipes →</a>
	</p>
</BaseLayout>
